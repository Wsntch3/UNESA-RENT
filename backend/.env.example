APP_ENV=development
APP_ADDR=:8080
JWT_SECRET=
JWT_TTL=24h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://unesarent:unesarent_dev@localhost:5433/unesarent?sslmode=disable
STORE_PATH=data/users.json
KTM_STORAGE_DIR=data/ktm
LISTING_STORAGE_DIR=data/listings

# PDF Surat Pernyataan Keamanan yang sudah disiapkan (hanya ditampilkan).
AGREEMENT_PDF_PATH=assets/rental-agreement.pdf

# Kosongkan DATABASE_URL untuk memakai file JSON (mode dev lama).
# Isi untuk memakai PostgreSQL (lihat postgres/README.md).
# Catatan: jika port 5432 sudah dipakai PostgreSQL lain, set POSTGRES_PORT=5433
# di postgres/.env dan sesuaikan port di bawah.
DATABASE_URL=

# Dipakai hanya saat DATABASE_URL kosong.
STORE_PATH=data/users.json

# Penyimpanan file KTM (dev). Untuk produksi, ganti implementasi ktm.Storage
# ke Supabase; nilai ini tidak dipakai oleh storage Supabase.
KTM_STORAGE_DIR=data/ktm

# Penyimpanan foto listing (dev). Hanya dipakai saat DATABASE_URL diisi.
LISTING_STORAGE_DIR=data/listings
